rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Topics: Public read, Admin write
    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Questions bank: Public read, Admin write
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Exams: Public read, Admin write
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users collection and subcollections
    match /users/{userId} {
      // Any authenticated user can read basic profile; owner can read/write their own
      allow read: if isAuthenticated();
      // Owner can update their profile, but cannot tamper with their own 'role' field
      allow create: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'student');
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin());
      allow delete: if isAdmin();
      
      // Subcollection for user test attempts & practice history
      match /attempts/{attemptId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // Subcollection for user's wrong question notebook
      match /mistakes/{mistakeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // Subcollection for bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // Root level attempts query (if needed for global leaderboards)
    match /attempts/{attemptId} {
      allow read: if true; // Public leaderboard or owner
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
